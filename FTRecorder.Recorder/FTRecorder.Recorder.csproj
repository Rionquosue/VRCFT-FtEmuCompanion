<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Recorder app: dotnet publish FTRecorder.Recorder -c Release -r win-x64 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RiryTools.FTRecorder.Recorder</AssemblyName>
    <AvaloniaVersion>12.1.5</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared with the companion app's process command. -->
    <Compile Include="..\FTRecorder.Companion\FTRecorderCaptions.cs" Link="Companion\FTRecorderCaptions.cs" />
    <Compile Include="..\FTRecorder.Companion\FTRecorderVrchatListener.cs" Link="Companion\FTRecorderVrchatListener.cs" />
    <!-- Recording needs no face models: they and ONNX Runtime are left out. -->
    <Compile Remove="$(MSBuildThisFileDirectory)..\FTRecorder.Core\FTRecorderFace*.cs;$(MSBuildThisFileDirectory)..\FTRecorder.Core\FTRecorderBabbleModel.cs;$(MSBuildThisFileDirectory)..\FTRecorder.Core\FTRecorderModelFiles.cs;$(MSBuildThisFileDirectory)..\FTRecorder.Core\FTRecorderVideoProcessor.cs" />
    <PackageReference Remove="Microsoft.ML.OnnxRuntime" />
    <None Remove="$(MSBuildThisFileDirectory)..\Models\*.*" />
    <!-- Valve's OpenVR (SDK 2.15.6, win64) for Start with SteamVR. -->
    <None Include="$(MSBuildThisFileDirectory)..\ThirdParty\OpenVR\openvr_api.dll" Link="openvr_api.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>
</Project>
